# Copy to .env. Every line here is a HyperQwen launcher knob unless noted.

# Which checkpoint: uncensored (Ar4ikov/Qwen3.8-27B-Uncensored-AWQ-W4A16-ASYM-HyperQwen)
# or base (Ar4ikov/Qwen3.8-27B-AWQ-W4A16-ASYM-HyperQwen). Both are prepared already.
CHECKPOINT=uncensored

# The stable single-3090 profile: Qwen's own MTP head, bf16 KV, 64k context, vision on.
SPEC=mtp
CTX=fast
PREFIX_CACHE=1
VISION=1
# VISION_OFFLOAD=1 (default) keeps the 0.85 GiB tower in pinned host RAM and streams it
# per image (~36 ms extra per image). VISION_OFFLOAD=0 needs the room: fine on TP=2.

# Faster on one card, a little tighter on memory: the DFlash2 block drafter.
# SPEC=dflash2
# KV_MEM=4300000000

# Batch/API profile extras live in batch/start_qwen.sh (INT8_ACT=int8 is its default and
# works on these asymmetric checkpoints thanks to patches/marlin-int8-asym-zp.patch).

# Docker Desktop on WSL2 needs this or the V2 runner aborts with "UVA is not available".
VLLM_WSL2_ENABLE_PIN_MEMORY=1

# Before exposing the port: the server binds 0.0.0.0 and is open without a key.
# VLLM_API_KEY=

# PORT=18020
# MODELS_DIR=./models
# GPU_COUNT=1          # tp2 profile: 2
# IMAGE_TAG=latest     # or a release, e.g. 1.0.0
