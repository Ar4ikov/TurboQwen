# Profile P: HyperQwen's "production line" on one RTX 3090 -- DFlash2 with a 15-token
# verify block, int8 Marlin GEMMs (W4A8, the asym patch makes this legal here) and the
# int8-QK prefill attention. Fastest prefill; quotes its prompt back at 300+ tok/s.
CHECKPOINT=uncensored
SPEC=dflash2
CTX=fast
PREFIX_CACHE=1
VISION=1
KV_MEM=4300000000
DFLASH_TOKENS=15
INT8_ACT=int8
PREFILL_ATTN=int8
