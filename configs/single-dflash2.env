# Profile D: one RTX 3090, the DFlash2 block drafter (7 drafts per pass), bf16 KV, 64k,
# vision on. The KV pool is pinned a gigabyte under HyperQwen's default because these
# checkpoints carry ~0.6 GiB more weight than the base -fast variant the pin was sized on.
CHECKPOINT=uncensored
SPEC=dflash2
CTX=fast
PREFIX_CACHE=1
VISION=1
KV_MEM=4300000000
DFLASH_MAX_LEN=49152
