# Profile B: one RTX 3090 as an API backend, 64 concurrent requests, int8 Marlin GEMMs
# (batch/start_qwen.sh defaults: INT8_ACT=int8 INT8_LAYERS=mlp, fp8 KV, 150k context).
# Start with: docker compose --profile batch up -d
CHECKPOINT=uncensored
VISION=1
# the launcher's own 0.972 / 150k OOMs at warmup with the int8 heads and the tower on;
# 0.94 / 100k boots with a 215k-token fp8 pool
GPU_UTIL=0.94
MAX_LEN=100000
