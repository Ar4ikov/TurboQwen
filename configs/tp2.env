# Profile T: two cards, tensor parallel 2, the single-user MTP profile with the vision tower
# resident on the GPU (no host offload) and the full 262k context the checkpoint supports.
# Start with: docker compose --profile tp2 up -d
CHECKPOINT=uncensored
SPEC=mtp
CTX=long
MAX_LEN=262144
PREFIX_CACHE=1
VISION=1
VISION_OFFLOAD=0
GPU_COUNT=2
